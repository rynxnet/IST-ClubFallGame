; Engine configuration file.
; Edit through Project > Project Settings in the editor when you can.
; This file is a merge-conflict hotspot, so keep changes to it in their own small PRs.

config_version=5

[application]

config/name="IST Club Fall Game"
config/description="Collaborative 3D game - IST Club, Fall 2026. Starter loop: first-person wave survival."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
UIManager="*res://scripts/ui/ui_manager.gd"

